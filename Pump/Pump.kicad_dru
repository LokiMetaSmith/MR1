(version 1)

(rule "USB Diff Pair Gap"
  (condition "A.hasNetclass('USB_Diff')")
  (constraint diff_pair_gap (min 0.15mm) (opt 0.18mm) (max 0.25mm))
)

(rule "USB Diff Pair Uncoupled Connector"
  (condition "A.NetName == '/USB_Interconnect/HOST_D+' || A.NetName == '/USB_Interconnect/HOST_D-' || A.NetName == '/USB_Interconnect/MR1_D+' || A.NetName == '/USB_Interconnect/MR1_D-' || A.NetName == '/MCU_STM32/USB_MCU_D+' || A.NetName == '/MCU_STM32/USB_MCU_D-'")
  (constraint diff_pair_uncoupled (max 4.0mm))
)

(rule "USB Diff Pair Uncoupled Mux"
  (condition "A.NetName == '/USB_Interconnect/HOST_MUX_D+' || A.NetName == '/USB_Interconnect/HOST_MUX_D-' || A.NetName == '/USB_Interconnect/MR1_MUX_D+' || A.NetName == '/USB_Interconnect/MR1_MUX_D-'")
  (constraint diff_pair_uncoupled (max 7.5mm))
)

(rule "USB Diff Pair Skew HOST_D"
  (condition "A.NetName == '/USB_Interconnect/HOST_D+' || A.NetName == '/USB_Interconnect/HOST_D-'")
  (constraint skew (max 0.15mm))
)

(rule "USB Diff Pair Skew HOST_MUX"
  (condition "A.NetName == '/USB_Interconnect/HOST_MUX_D+' || A.NetName == '/USB_Interconnect/HOST_MUX_D-'")
  (constraint skew (max 0.15mm))
)

(rule "USB Diff Pair Skew MR1_D"
  (condition "A.NetName == '/USB_Interconnect/MR1_D+' || A.NetName == '/USB_Interconnect/MR1_D-'")
  (constraint skew (max 0.15mm))
)

(rule "USB Diff Pair Skew MR1_MUX"
  (condition "A.NetName == '/USB_Interconnect/MR1_MUX_D+' || A.NetName == '/USB_Interconnect/MR1_MUX_D-'")
  (constraint skew (max 0.15mm))
)

(rule "USB Diff Pair Skew USB_MCU"
  (condition "A.NetName == '/MCU_STM32/USB_MCU_D+' || A.NetName == '/MCU_STM32/USB_MCU_D-'")
  (constraint skew (max 0.15mm))
)
